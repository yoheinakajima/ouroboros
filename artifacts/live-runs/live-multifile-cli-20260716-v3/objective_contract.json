{
  "capability_requirements": [
    "Read input sentence from stdin",
    "Parse and analyze text to count words",
    "Identify unique words in the input",
    "Determine the longest word in the input",
    "Output results as valid JSON to stdout",
    "Handle edge cases (empty input, punctuation, multiple spaces)"
  ],
  "deliverable_kind": "JSON-stdin CLI application",
  "entrypoint_protocol": "JSON output to stdout from stdin input",
  "objective": "Build a multi-file JSON-stdin CLI that analyzes an input sentence and returns valid JSON containing word_count, unique_words, and longest_word, with real automated tests.",
  "public_behavior_spec": [
    "CLI accepts a sentence via stdin",
    "CLI outputs valid JSON with exactly three fields: word_count (integer), unique_words (integer), longest_word (string)",
    "word_count represents total number of words in the input",
    "unique_words represents count of distinct words (case-insensitive)",
    "longest_word is the longest word found; if tie, any valid longest word is acceptable",
    "Words are separated by whitespace; punctuation handling should be reasonable",
    "Empty or whitespace-only input should produce word_count=0, unique_words=0, longest_word=\"\"",
    "Exit code 0 on successful processing"
  ],
