  "capability_requirements": [
    "Read JSON from stdin containing a sentence field",
    "Parse and analyze text to count words",
    "Identify unique words in the input",
    "Determine the longest word in the input",
    "Output valid JSON with word_count, unique_words, and longest_word fields",
    "Handle edge cases like empty input, punctuation, and multiple spaces"
  ],
  "deliverable_kind": "JSON-stdin CLI application",
  "entrypoint_protocol": "JSON-stdin CLI: reads JSON from stdin, writes JSON to stdout, exits 0 on success",
  "objective": "Build a multi-file JSON-stdin CLI that analyzes an input sentence and returns valid JSON containing word_count, unique_words, and longest_word, with real automated tests.",
  "public_behavior_spec": [
    "CLI accepts JSON on stdin with a 'sentence' field",
    "CLI outputs valid JSON to stdout",
    "Output JSON contains 'word_count' (integer) representing total word count",
    "Output JSON contains 'unique_words' (integer) representing count of unique words",
    "Output JSON contains 'longest_word' (string) representing the longest word found",
    "Words are separated by whitespace",
    "Word comparison is case-insensitive for uniqueness counting",
    "If multiple words tie for longest, any one of them is acceptable",
    "Punctuation attached to words is considered part of the word",
    "Empty or whitespace-only input results in word_count=0, unique_words=0, longest_word=empty string"
  ],
