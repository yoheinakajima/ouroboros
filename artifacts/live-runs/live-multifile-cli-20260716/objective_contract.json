{
  "capability_requirements": [
    "Read input sentence from stdin",
    "Parse and analyze text to count words",
    "Identify unique words in the input",
    "Determine the longest word in the input",
    "Output valid JSON to stdout",
    "Handle edge cases (empty input, punctuation, multiple spaces)"
  ],
  "deliverable_kind": "JSON-stdin CLI application",
  "entrypoint_protocol": "JSON-stdin CLI: reads from stdin, writes JSON to stdout",
  "objective": "Build a multi-file JSON-stdin CLI that analyzes an input sentence and returns valid JSON containing word_count, unique_words, and longest_word, with real automated tests.",
  "public_behavior_spec": [
    "CLI accepts a sentence via stdin",
    "CLI outputs valid JSON with exactly three fields: word_count (integer), unique_words (integer), and longest_word (string)",
    "word_count represents the total number of words in the input",
    "unique_words represents the count of distinct words (case-insensitive)",
    "longest_word is the longest word found; if multiple words tie, any one is acceptable",
    "Words are separated by whitespace; punctuation attached to words is considered part of the word",
    "Empty or whitespace-only input produces word_count=0, unique_words=0, longest_word=\"\"",
    "Exit code 0 indicates successful execution"
  ],
