__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ouroboros/
.venv/
dist/
build/
*.egg-info/
.DS_Store
.env*
!.env.example

# Raw run directories are local evidence. Publish curated summaries in
# evidence/ and attach full immutable bundles to releases instead of Git.
artifacts/**
!artifacts/README.md

# External benchmark images, datasets, caches, and paid run outputs.
benchmark/.cache/
benchmark/runs/
.benchmark-cache/

# Harbor's default output when a caller omits --jobs-dir. Curated receipts
# belong in evidence/; complete local job trees may contain model transcripts.
jobs/

# Local render intermediates. Canonical paper source and final PDF are tracked.
paper/tmp/
/output/
/tmp/
